{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "2026-10-31 revision: short paper, extended web/deep reading, current-hexagram questions. Backend execution pending.",
  "oneOf": [
    {
      "$ref": "#/$defs/base_reading"
    },
    {
      "$ref": "#/$defs/deep_reading"
    }
  ],
  "$defs": {
    "base_reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "message",
        "action"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 12,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 20,
          "maxLength": 50,
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "minLength": 8,
          "maxLength": 25,
          "pattern": "\\S"
        }
      }
    },
    "deep_reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "meaning",
        "reflection",
        "action"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "\\S"
        },
        "meaning": {
          "type": "string",
          "minLength": 80,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "reflection": {
          "type": "string",
          "minLength": 80,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "minLength": 12,
          "maxLength": 100,
          "pattern": "\\S"
        }
      }
    },
    "question_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "question_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning",
        "reflection",
        "action"
      ],
      "properties": {
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "reflection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        }
      }
    }
  }
}
